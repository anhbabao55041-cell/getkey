# PORT cấu hình server (Render sẽ tự động gán PORT)
PORT=3000

# Khóa bí mật HMAC để ký và xác thực token (Thay đổi bằng chuỗi ngẫu nhiên dài và bảo mật)
HMAC_SECRET=your_super_secret_hmac_key_random_string_here_987654321

# Mật khẩu quản trị viên (Admin Panel)
ADMIN_PASSWORD=quocthai

# JWT Secret cho phiên đăng nhập Admin
JWT_SECRET=jwt_super_secret_admin_session_token_key_change_me

# Token API của Link4M (Lấy trong Dashboard Link4M -> Công cụ / API)
LINK4M_API_KEY=6a44cabb1c08580bcd40f8ce

# Tên miền website của bạn (Dùng khi sinh link xác thực gửi cho Link4M)
# Ví dụ khi deploy lên Render: https://your-app-name.onrender.com
# Khi chạy localhost: http://localhost:3000
SITE_URL=http://localhost:3000

# Thời gian tối thiểu (giây) con người vượt Link4M để chặn công cụ Bypass tự động
# Khuyên dùng: 20 đến 35 giây (Tool bypass thường giải mã trong 1-5 giây sẽ bị chặn ngay)
MIN_WAIT_SECONDS=20

# Thời hạn token session tồn tại tối đa (giây). Mặc định 900 giây (15 phút)
SESSION_EXPIRE_SECONDS=900

# (Tùy chọn) Kết nối MongoDB Atlas để lưu vĩnh viễn trên Render Free Tier
# Mẫu: mongodb+srv://username:password@cluster0.abcde.mongodb.net/getkey_db?retryWrites=true&w=majority
# Nếu để trống, hệ thống sẽ tự động dùng JSON Database cục bộ trong thư mục data/
MONGODB_URI=
